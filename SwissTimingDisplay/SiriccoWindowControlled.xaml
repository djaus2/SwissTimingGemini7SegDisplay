<Window x:Class="SwissTimingDisplay.SiriccoWindowControlled"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Siricco Controlled" Height="466" Width="775">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="DarkGreen" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6">
            <Button x:Name="startButton" Content="{Binding StartButtonContent}" Click="StartButton_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStyleGreen}" />
            <GroupBox Margin="0,0,6,0">
                <GroupBox.Header>
                    <CheckBox x:Name="showSetup" IsChecked="True" VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" FontStyle="Italic" Text="Setup" />
                    </CheckBox>
                </GroupBox.Header>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=showSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="toggleControls" Click="ToggleControls_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStyle}">
                        <Button.Content>
                            <TextBlock FontWeight="Bold" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show Controls" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ControlVisibility}" Value="Visible">
                                                <Setter Property="Text" Value="Hide Controls" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <TextBlock Text="Receive Port" VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Foreground="Purple" Margin="0,0,6,0" />
                    <ComboBox x:Name="receivePortCombo" Width="120" VerticalAlignment="Center" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding DataContext.ReceivePortsView}" SelectedValuePath="PortName" SelectedValue="{Binding DataContext.SelectedReceivePortName, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,6,0" />
                    <Button x:Name="receiveConnectButton" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStyle}" Command="{Binding DataContext.ReceiveConnectToggleCommand}">
                        <Button.Content>
                            <TextBlock FontWeight="Bold" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Connect" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsReceiveConnected}" Value="True">
                                                <Setter Property="Text" Value="Disconnect" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="refreshPortsButton" Padding="10,4" Style="{StaticResource SnazzyButtonStyle}" Command="{Binding DataContext.RefreshPortsCommand}">
                        <Button.Content>
                            <TextBlock FontWeight="Bold" FontStyle="Italic" Text="Refresh Ports" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Grid x:Name="controlHost" Grid.Row="1" />
    </Grid>
</Window>

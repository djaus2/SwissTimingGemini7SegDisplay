<Window x:Class="SwissTimingDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SwissTimingDisplay.Controls"
        mc:Ignorable="d"
        Title="Swiss Timing Display" Height="660" Width="834" Closing="Window_Closing"
        Background="#E8F5E9">
    <Grid x:Name="rootGrid" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:SwissTimingDisplayToolbar Grid.Row="0" DisplayControl="{x:Reference displayControl}" />
        <controls:SwissTimingDisplayControl x:Name="displayControl" Grid.Row="1" />
    </Grid>
</Window>

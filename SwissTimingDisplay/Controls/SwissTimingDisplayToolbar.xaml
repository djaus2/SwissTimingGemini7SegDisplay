<UserControl x:Class="SwissTimingDisplay.Controls.SwissTimingDisplayToolbar"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:SwissTimingDisplay.Properties"
             xmlns:converters="clr-namespace:SwissTimingDisplay.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="DarkGreen" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button x:Name="startButton"
                Content="{Binding DisplayControl.StartButtonContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="StartButton_Click"
                Padding="10,4"
                Margin="0,0,6,0"
                Style="{StaticResource SnazzyButtonStyleGreen}" />
        <Button x:Name="lapButton"
                Content="{Binding DisplayControl.LapButtonContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="{Binding DisplayControl.LapButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="LapButton_Click"
                Padding="10,4"
                Margin="0,0,6,0"
                Style="{StaticResource SnazzyButtonStyle}" />
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,6,0" Background="Beige">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="showSetup" IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=ShowSetup, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" Padding="6,2">
                    <TextBlock FontWeight="Bold" FontStyle="Italic" Text="Setup" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=showSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="toggleControls" Click="ToggleControls_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStyle}">
                        <Button.Content>
                            <TextBlock FontWeight="Bold" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show Controls" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayControl.ControlVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Visible">
                                                <Setter Property="Text" Value="Hide Controls" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=showSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Foreground="Purple" Margin="0,0,6,0"
                       Text="{Binding DisplaySelectedSendPortName, StringFormat='Send: {0}'}"
                       Visibility="{Binding DisplayIsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Foreground="Purple" Margin="0,0,6,0"
                       Text="{Binding DisplaySelectedReceivePortName, StringFormat='Receive: {0}'}"
                       Visibility="{Binding DisplayIsReceiveConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Foreground="Red" Margin="0,0,6,0" Text="Not Connected">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DisplayIsConnected}" Value="False" />
                                    <Condition Binding="{Binding DisplayIsReceiveConnected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="backButton" Content="Back" Click="BackButton_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStylePurple}" Visibility="{Binding ShowBackExit, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <Button x:Name="exitButton" Content="Exit" Click="ExitButton_Click" Padding="10,4" Style="{StaticResource SnazzyButtonStyleRed}" Visibility="{Binding ShowBackExit, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>

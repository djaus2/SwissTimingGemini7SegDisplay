<UserControl x:Class="SwissTimingDisplay.Controls.SprintToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SwissTimingDisplay.ViewModels"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:SwissTimingDisplay.Converters">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="SprintsEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:Sprints" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <converters:SprintDisplayConverter x:Key="SprintDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button x:Name="startRaceButton"
                Content="{Binding DisplayControl.StartButtonContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding CanStartRace, Mode=OneWay}"
                Click="StartRaceButton_Click"
                Padding="10,4"
                Margin="0,0,6,0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SnazzyButtonStyleGreen}">
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#95A5A6" Offset="0" />
                                        <GradientStop Color="#7F8C8D" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush" Value="#555555" />
                            <Setter Property="Foreground" Value="#DDDDDD" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="startWindGaugeButton"
                Content="Start Wind Gauge"
                Click="StartWindGaugeButton_Click"
                Padding="10,4"
                Margin="0,0,6,0"
                Visibility="{Binding ShowWindGaugeButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource SnazzyButtonStyle}" />
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,6,0" Background="Beige">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="showSetup" Checked="ShowSetup_Checked" Unchecked="ShowSetup_Unchecked" VerticalAlignment="Center" Margin="0,0,6,0" Padding="6,2">
                    <TextBlock FontWeight="Bold" FontStyle="Italic" Text="Setup" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=showSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button x:Name="toggleControls" Click="ToggleControls_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStyle}">
                        <Button.Content>
                            <TextBlock FontWeight="Bold" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show Controls" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SprintShowSetup}" Value="True">
                                                <Setter Property="Text" Value="Hide Controls" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,6,0" Background="Beige">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sprint:" FontWeight="Bold" FontStyle="Italic" Foreground="Purple" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="sprintComboBox"
                          MinWidth="120"
                          ItemsSource="{Binding Source={StaticResource SprintsEnum}}"
                          SelectedItem="{Binding Sprint, Mode=TwoWay}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SprintDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>
        <Button x:Name="backButton" Content="Back" Click="BackButton_Click" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SnazzyButtonStylePurple}" />
        <Button x:Name="exitButton" Content="Exit" Click="ExitButton_Click" Padding="10,4" Style="{StaticResource SnazzyButtonStyleRed}" />
    </StackPanel>
</UserControl>
